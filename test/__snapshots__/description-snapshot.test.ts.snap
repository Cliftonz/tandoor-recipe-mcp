  {
    "description": "Update a shopping-list-recipe (PATCH). Required: id.",
    "name": "update_shopping_list_recipe",
  },
  {
    "description": "Update a space (PATCH). Required: id, plus at least one field.",
    "name": "update_space",
  },
  {
    "description": "Update a step (PATCH). Required: id. Any field provided replaces. ingredients[] is a full replacement of the step's ingredients.",
    "name": "update_step",
  },
  {
    "description": "Update a storage backend (PATCH). Required: id. Storage records contain credentials for external file backends. Slim mode redacts token/password; use format='full' only if needed.",
    "name": "update_storage",
