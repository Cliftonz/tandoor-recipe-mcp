  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "create_stub_on_failure": {
          "description": "Default false. When true AND both scraper attempts fail, create a minimal empty recipe pointing at the URL instead of throwing.",
          "type": "boolean",
        },
        "format": {
          "description": "Response detail level. Default "slim".",
          "enum": [
            "slim",
            "full",
          ],
          "type": "string",
        },
        "name": {
          "description": "Optional name for the stub recipe (only used if create_stub_on_failure=true and both scrapers fail)",
          "type": "string",
        },
        "url": {
          "description": "Recipe URL to import",
          "type": "string",
        },
      },
      "required": [
