    "name": "update_invite_link",
  },
  {
    "description": "Update keyword (PATCH). Required: id.",
    "name": "update_keyword",
  },
  {
    "description": "Update meal plan. Required: id. All other fields optional",
    "name": "update_meal_plan",
  },
  {
    "description": "Update a meal type (PATCH). Required: id.",
    "name": "update_meal_type",
  },
  {
    "description": "Update property (PATCH). Required: id.",
    "name": "update_property",
  },
  {
    "description": "Update property type (PATCH). Required: id.",
    "name": "update_property_type",
  },
  {
    "description": "Update recipe metadata and content. Only provide fields you want to update. All fields optional except id.",
    "name": "update_recipe",
  },
  {
    "description": "Update a recipe book (PATCH). Required: id.",
    "name": "update_recipe_book",
  },
  {
    "description": "Update a pending recipe-import queue entry (PATCH). Required: id.",
    "name": "update_recipe_import",
  },
