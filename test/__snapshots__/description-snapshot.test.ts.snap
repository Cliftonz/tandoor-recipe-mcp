          "enum": [
            "slim",
            "full",
          ],
          "type": "string",
        },
        "name": {
          "description": "Override name if AI did not extract one",
          "type": "string",
        },
        "save": {
          "description": "Save parsed recipe to Tandoor (default true)",
          "type": "boolean",
        },
        "text": {
          "description": "Optional raw recipe text to feed the AI provider",
          "type": "string",
        },
      },
      "type": "object",
    },
