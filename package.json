{
  "name": "@cliftonz/tandoor-recipes-mcp",
  "version": "2.0.0",
  "description": "Model Context Protocol server for Tandoor — recipes, meal plans, shopping lists, ingredients, cook logs, nutrition, AI import, and more.",
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "tandoor-recipes-mcp": "./build/index.js"
  },
  "files": [
    "build/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:ci": "cross-env CI=1 vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm run test:ci",
    "version": "node scripts/sync-plugin-version.js && git add .claude-plugin/plugin.json .claude-plugin/marketplace.json"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tandoor",
    "recipes",
    "meal-planning",
    "cooking",
    "food",
    "recipe-management",
    "claude",
    "anthropic"
  ],
  "author": "Zac Clifton",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cliftonz/tandoor-recipe-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Cliftonz/tandoor-recipe-mcp/issues"
  },
  "homepage": "https://github.com/Cliftonz/tandoor-recipe-mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "jq-wasm": "3.0.0-jq-1.8.2",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "typescript": "7.0.2",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
