{
  "name": "@cliftonz/tandoor-recipes-mcp",
  "version": "3.4.1",
  "mcpName": "io.github.Cliftonz/tandoor-recipe-mcp",
  "description": "Model Context Protocol server for Tandoor — recipes, meal plans, shopping lists, ingredients, cook logs, nutrition, AI import, and more.",
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "tandoor-recipes-mcp": "./build/index.js"
  },
  "files": [
    "build/**/*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "lint": "oxlint --deny-warnings src test scripts vitest.config.ts vitest.e2e.config.ts",
    "test": "vitest run",
    "test:ci": "cross-env CI=1 vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "mcpb": "npx --yes @anthropic-ai/mcpb@2.1.2",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm run test:ci",
    "version": "node scripts/sync-plugin-version.js && git add plugins/claude/.claude-plugin/plugin.json .claude-plugin/marketplace.json .codex-plugin/plugin.json manifest.json server.json"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tandoor",
    "recipes",
    "meal-planning",
    "cooking",
    "food",
    "recipe-management",
    "claude",
    "anthropic"
  ],
  "author": "Zac Clifton",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cliftonz/tandoor-recipe-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Cliftonz/tandoor-recipe-mcp/issues"
  },
  "homepage": "https://github.com/Cliftonz/tandoor-recipe-mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "jq-wasm": "3.0.0-jq-1.8.2",
    "undici": "^8.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.8",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
